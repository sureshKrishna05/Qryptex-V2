---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions"; 

import SEO from "../components/seo/SEO.astro";
import FlashNews from "../components/navigation/FlashNews.astro";
import Navbar from "../components/navigation/Navbar.astro";
import Footer from "../components/navigation/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="preload overflow-x-hidden scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
    />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <ClientRouter />
    
    <script is:inline>
      const applyTheme = () => {
        const savedTheme = localStorage.getItem('theme');
        const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        
        if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      };

      const removePreload = () => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove('preload');
        });
      };

      // 1. Apply theme instantly before DOM painting
      applyTheme();

      // 2. Remove preload guard on initial load AND after every Astro page navigation
      window.addEventListener('DOMContentLoaded', removePreload);
      document.addEventListener('astro:page-load', removePreload);
      document.addEventListener('astro:after-swap', removePreload);

      // 3. Re-apply theme instantly during Astro ClientRouter page swaps
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>

  <body
    class="min-h-screen bg-[var(--color-background)] text-[var(--color-text)] antialiased overflow-x-hidden selection:bg-[var(--color-accent)] selection:text-white"
  >
    <div class="relative flex min-h-screen flex-col overflow-x-hidden">
      <FlashNews />
      <Navbar />

      <main class="flex-grow">
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>