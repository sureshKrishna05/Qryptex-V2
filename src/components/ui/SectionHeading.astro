---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const {
  eyebrow,
  title,
  description
} = Astro.props;
---

<div class="max-w-3xl">
  {
    eyebrow && (
      <p
        class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-[var(--color-accent)]"
      >
        {eyebrow}
      </p>
    )
  }

  <h2
    class="text-4xl font-bold tracking-tight text-[var(--color-text)] md:text-5xl"
  >
    {title}
  </h2>

  {
    description && (
      <p
        class="mt-4 text-lg leading-relaxed text-[var(--color-text-muted)]"
      >
        {description}
      </p>
    )
  }
</div>