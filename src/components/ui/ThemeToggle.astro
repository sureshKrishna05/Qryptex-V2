---
// src/components/ui/ThemeToggle.astro
---

<button
  class="theme-toggle-btn group relative flex h-10 w-10 items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:shadow-md hover:border-[var(--color-accent)] overflow-hidden transform-gpu"
  aria-label="Toggle Theme"
>
  <!-- Sun Icon -->
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    class="sun-icon absolute h-5 w-5 text-[var(--color-text)] transform-gpu" 
    fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>

  <!-- Moon Icon -->
  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    class="moon-icon absolute h-5 w-5 text-[var(--color-accent)] transform-gpu" 
    fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<style is:global>
  /* 1. Default Light Mode State */
  .sun-icon { 
    transform: rotate(0deg) scale(1); 
    opacity: 1; 
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .moon-icon { 
    transform: rotate(90deg) scale(0.5); 
    opacity: 0; 
    transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 2. Dark Mode Override */
  html.dark .sun-icon { 
    transform: rotate(-90deg) scale(0.5); 
    opacity: 0; 
  }
  html.dark .moon-icon { 
    transform: rotate(0deg) scale(1); 
    opacity: 1; 
  }
</style>

<script is:inline>
  function setupThemeToggles() {
    const html = document.documentElement;
    const buttons = document.querySelectorAll(".theme-toggle-btn");

    buttons.forEach((btn) => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener("click", () => {
        html.classList.toggle("dark");
        const isDark = html.classList.contains("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    });
  }

  setupThemeToggles();
  document.addEventListener("astro:page-load", setupThemeToggles);
</script>