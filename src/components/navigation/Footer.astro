---
import Container from "../ui/Container.astro";
---

<footer class="relative overflow-hidden border-t border-[var(--color-border)] pt-20 pb-10 mt-auto bg-[var(--color-background)]">

  <Container class="relative z-10">

    <div class="grid gap-12 md:grid-cols-2 lg:gap-24">

      <div>
        <a
          href="/"
          class="inline-block text-3xl font-extrabold tracking-tight text-[var(--color-text)] transition-transform duration-300 hover:-translate-y-0.5"
          aria-label="Qryptex Home"
        >
          Qryptex
        </a>

        <p class="mt-6 max-w-md text-lg leading-relaxed text-[var(--color-text-muted)]">
          Security-first technology solutions helping organizations build secure software, intelligent systems, and resilient digital infrastructure.
        </p>
      </div>

      <div class="md:text-right">

        <h3 class="text-sm font-bold uppercase tracking-widest text-[var(--color-text)]">
          Contact
        </h3>

        <address class="mt-4 flex flex-col gap-2 not-italic md:items-end">

          <a
            href="mailto:contact@qryptex.in"
            class="text-lg font-medium text-[var(--color-text)] opacity-80 transition-colors duration-300 hover:text-[var(--color-accent)]"
          >
            contact@qryptex.in
          </a>

          <a
            href="tel:+917598576406"
            class="text-lg font-medium text-[var(--color-text)] opacity-80 transition-colors duration-300 hover:text-[var(--color-accent)]"
          >
            +91 7598576406
          </a>

        </address>

        <div class="mt-6 flex items-center justify-start gap-5 md:justify-end">

          <a
            href="mailto:contact@qryptex.in"
            aria-label="Send us an email"
            class="text-[var(--color-text)] opacity-80 transition-all duration-300 hover:-translate-y-1 hover:text-[var(--color-accent)] transform-gpu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
          </a>

          <a
            href="https://www.linkedin.com/company/qryptex-in/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on LinkedIn"
            class="text-[var(--color-text)] opacity-80 transition-all duration-300 hover:-translate-y-1 hover:text-[var(--color-accent)] transform-gpu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="h-5 w-5">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>

          <a
            href="https://www.instagram.com/qryptex.in/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Follow us on Instagram"
            class="text-[var(--color-text)] opacity-80 transition-all duration-300 hover:-translate-y-1 hover:text-[var(--color-accent)] transform-gpu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
              <rect width="16" height="16" x="4" y="4" rx="4" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="12" cy="12" r="3" stroke-linecap="round" stroke-linejoin="round" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 7.5v.001" />
            </svg>
          </a>

        </div>

        <p class="mt-8 text-sm font-medium text-[var(--color-text)] opacity-80">
          Security First. <span class="text-[var(--color-accent)]">Innovation Always.</span>
        </p>

      </div>

    </div>

    <div class="mt-20 flex flex-col items-center justify-between gap-6 border-t border-[var(--color-border)] pt-8 lg:flex-row">

      <p class="text-sm font-medium text-[var(--color-text)] opacity-70 text-center lg:text-left">
        &copy; {new Date().getFullYear()} Qryptex. All rights reserved.
      </p>

      <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">

        <a
          href="/terms#terms"
          class="text-sm font-medium text-[var(--color-text)] opacity-70 transition-colors hover:text-[var(--color-accent)]"
        >
          Terms of Service
        </a>

        <a
          href="/terms#privacy"
          class="text-sm font-medium text-[var(--color-text)] opacity-70 transition-colors hover:text-[var(--color-accent)]"
        >
          Privacy Policy
        </a>

        <a
          href="/terms#cookies"
          class="text-sm font-medium text-[var(--color-text)] opacity-70 transition-colors hover:text-[var(--color-accent)]"
        >
          Cookie Policy
        </a>

      </div>

    </div>

  </Container>
</footer>