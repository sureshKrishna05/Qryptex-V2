---
// src/components/navigation/FlashNews.astro
import { siteConfig } from "../../data/site";

if (!siteConfig.flashNews?.enabled) {
  return;
}

const {
  badge = siteConfig.flashNews.badge || "EXCLUSIVE SPONSORSHIP OPPORTUNITY",
  title = siteConfig.flashNews.title || "Partner With Next-Gen Quantum Innovators",
  subtitle = "Qiskit Fallfest 2026 • Bharathidasan University",
  description = siteConfig.flashNews.description || "We are hosting Qiskit Fallfest 2026 at Bharathidasan University—bringing together top student engineers, researchers, and developers. Grab the opportunity to position your brand at the forefront of quantum computing and talent acquisition.",
  ctaText = siteConfig.flashNews.ctaText || "Claim Sponsorship Prospectus",
  href = siteConfig.flashNews.href || "/contact",
  delayMs = siteConfig.flashNews.delayMs || 800,
} = Astro.props;

const benefits = [
  { label: "Talent Pipeline", desc: "Direct networking access to top engineering & research students." },
  { label: "Brand Spotlight", desc: "Keynote recognition, logo placement, and digital reach." },
  { label: "Tech Leadership", desc: "Showcase your APIs, tools, or challenges during the hackathon." }
];
---

<div
  id="flash-news-popup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="flash-popup-title"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu"
>
  {/* Darkened Glass Backdrop */}
  <div
    id="flash-popup-backdrop"
    class="absolute inset-0 bg-black/65 backdrop-blur-md transition-opacity duration-600 ease-[cubic-bezier(0.16,1,0.3,1)]"
    aria-hidden="true"
  ></div>

  {/* Modal Card with Apple-style Deceleration Easing */}
  <div
    id="flash-popup-card"
    class="relative z-10 w-full max-w-2xl translate-y-8 scale-90 overflow-hidden rounded-[2.5rem] border border-[var(--color-border)] bg-[var(--color-surface)]/95 p-8 shadow-2xl shadow-black/40 backdrop-blur-2xl transition-all duration-800 ease-[cubic-bezier(0.16,1,0.3,1)] sm:p-10 transform-gpu will-change-transform"
  >
    {/* Clean Top Gold Accent Bar */}
    <div
      class="absolute left-0 top-0 h-1.5 w-full bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-80"
      aria-hidden="true"
    ></div>

    {/* Header & Dismiss Button */}
    <div class="flex items-center justify-between gap-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-accent)]/40 bg-[var(--color-accent-glow)] px-3.5 py-1.5 text-xs font-bold uppercase tracking-widest text-[var(--color-accent)]">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
        </span>
        {badge}
      </span>

      <button
        id="close-flash-popup"
        type="button"
        aria-label="Close advertisement"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-text-muted)] transition-all duration-300 hover:border-[var(--color-accent)] hover:text-[var(--color-text)] active:scale-90 transform-gpu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="h-5 w-5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* Title & High-Value Copy */}
    <div class="mt-6 text-left">
      <p class="text-sm font-extrabold uppercase tracking-widest text-[var(--color-accent)]">
        {subtitle}
      </p>
      <h3
        id="flash-popup-title"
        class="mt-1 text-3xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-4xl"
      >
        {title}
      </h3>
      <p class="mt-4 text-base leading-relaxed text-[var(--color-text-muted)] sm:text-lg">
        {description}
      </p>
    </div>

    {/* Value-Prop Benefit Grid */}
    <div class="mt-8 grid gap-4 border-t border-b border-[var(--color-border)] py-6 sm:grid-cols-3">
      {benefits.map((item) => (
        <div class="flex flex-col">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)]">
            {item.label}
          </span>
          <span class="mt-1 text-xs leading-relaxed text-[var(--color-text-muted)]">
            {item.desc}
          </span>
        </div>
      ))}
    </div>

    {/* Actions */}
    <div class="mt-8 flex flex-col items-center justify-end gap-4 sm:flex-row">
      <button
        id="dismiss-flash-text"
        type="button"
        class="w-full rounded-xl px-5 py-3 text-sm font-semibold text-[var(--color-text-muted)] transition-colors duration-300 hover:text-[var(--color-text)] sm:w-auto"
      >
        Maybe Later
      </button>

      <a
        href={href}
        class="group inline-flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] px-8 py-4 text-sm font-bold text-white shadow-lg shadow-[var(--color-accent-glow)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[var(--color-accent-hover)] active:scale-95 sm:w-auto transform-gpu"
      >
        <span>{ctaText}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 transform-gpu"
        >
          <path
            fill-rule="evenodd"
            d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z"
          />
        </svg>
      </a>
    </div>
  </div>
</div>

<script is:inline define:vars={{ delayMs }}>
  function initFlashPopup() {
    const modal = document.getElementById("flash-news-popup");
    const backdrop = document.getElementById("flash-popup-backdrop");
    const card = document.getElementById("flash-popup-card");
    const closeBtn = document.getElementById("close-flash-popup");
    const dismissTextBtn = document.getElementById("dismiss-flash-text");

    if (!modal || !backdrop || !card || !closeBtn || !dismissTextBtn) return;

    // Only display once per browser reload/fresh session
    if (window.__flashPopupShownThisLoad) {
      modal.style.display = "none";
      return;
    }

    const openModal = () => {
      if (window.__flashPopupShownThisLoad) return;
      window.__flashPopupShownThisLoad = true;

      modal.style.display = "flex";

      // Double requestAnimationFrame guarantees the browser finishes layout
      // calculation before triggering the animation frames (0% stutter).
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          modal.classList.remove("pointer-events-none", "opacity-0");
          modal.classList.add("opacity-100");
          card.classList.remove("translate-y-8", "scale-90");
          card.classList.add("translate-y-0", "scale-100");
        });
      });

      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0", "pointer-events-none");
      card.classList.remove("translate-y-0", "scale-100");
      card.classList.add("translate-y-8", "scale-90");
      document.body.style.overflow = "";

      setTimeout(() => {
        modal.style.display = "none";
      }, 700);
    };

    // Replace elements to safely wipe old event listeners across Astro transitions
    const newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);

    const newDismissTextBtn = dismissTextBtn.cloneNode(true);
    dismissTextBtn.parentNode?.replaceChild(newDismissTextBtn, dismissTextBtn);

    const newBackdrop = backdrop.cloneNode(true);
    backdrop.parentNode?.replaceChild(newBackdrop, backdrop);

    newCloseBtn.addEventListener("click", closeModal);
    newDismissTextBtn.addEventListener("click", closeModal);
    newBackdrop.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("pointer-events-none")) {
        closeModal();
      }
    });

    const timer = setTimeout(openModal, delayMs);
    return () => clearTimeout(timer);
  }

  initFlashPopup();
  document.addEventListener("astro:page-load", initFlashPopup);
</script>