---
// src/components/navigation/FlashNews.astro
import { Image } from "astro:assets";
import { siteConfig } from "../../data/site";

// Import local assets from src/assets/

import qiskitLogo from "../../assets/qiskit-badge.png";

if (!siteConfig.flashNews?.enabled) {
  return;
}

const {
  title = siteConfig.flashNews.title || "Become an Official Industry Partner",
  subtitle = "IBM Qiskit Fall Fest 2026\nHosted at Bharathidasan University",
  description =
    siteConfig.flashNews.description ||
    "Support one of India's official IBM Qiskit Fall Fest 2026 events. Engage with exceptional student talent, researchers, and future quantum technology leaders through strategic sponsorship and industry partnership opportunities.",
  ctaText = siteConfig.flashNews.ctaText || "Become an Industry Partner",
  delayMs = siteConfig.flashNews.delayMs || 800,
} = Astro.props;
---

{/* ROOT MODAL: Uses 'invisible' GPU rendering to prevent initial page-load flicker */}
<div
  id="flash-news-popup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="flash-popup-title"
  aria-describedby="flash-popup-description"
  class="fixed inset-0 z-[100] flex invisible items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu sm:p-6 md:p-10"
>
  {/* Glass Backdrop */}
  <div
    id="flash-popup-backdrop"
    class="absolute inset-0 bg-black/70 backdrop-blur-md transition-opacity duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
    aria-hidden="true"
  ></div>

  {/* Modal Card - Semantic Container */}
  <section
    id="flash-popup-card"
    class="relative z-10 w-full max-w-3xl translate-y-8 scale-90 overflow-hidden rounded-[2.5rem] border border-[var(--color-border)] bg-[var(--color-surface)]/95 p-6 shadow-2xl shadow-black/50 backdrop-blur-2xl transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] sm:p-10 md:p-12 transform-gpu will-change-transform"
  >
    {/* Top Gold Accent Border */}
    <div
      class="absolute left-0 top-0 h-1.5 w-full bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-90"
      aria-hidden="true"
    ></div>

    {/* ================= HEADER ================= */}
    <header class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        {/* Optimized Pulsing Dot (Fixes non-composited animation warning) */}
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-75 transform-gpu will-change-transform will-change-[opacity]"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
        </span>
        <span class="text-xs font-extrabold uppercase tracking-widest text-[var(--color-text-muted)]">
          IBM QISKIT FALL FEST 2026 OFFICIAL SPONSORSHIP PROGRAM
        </span>
      </div>

      <button
        id="close-flash-popup"
        type="button"
        aria-label="Close advertisement dialog"
        class="group flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-text-muted)] shadow-xs transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-[var(--color-accent)] hover:bg-[var(--color-surface)] hover:text-[var(--color-text)] hover:shadow-md active:scale-90 transform-gpu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="h-5 w-5 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:rotate-90 transform-gpu"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </header>

    {/* ================= MAIN CONTENT ================= */}
    <main>
      {/* CO-BRANDED PARTNERSHIP LOGO SHOWCASE */}
      <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
        <div class="flex items-center gap-3.5">

          {/* Qiskit Fallfest Badge Container (Optimized with lazy load & WebP) */}
          <div class="group/logo flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-background)] p-2 shadow-sm transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-[var(--color-accent)]/60 hover:shadow-md sm:h-20 sm:w-20 transform-gpu">
            <Image
              src={qiskitLogo}
              alt="Qiskit Fallfest 2026 Badge"
              width={100}
              height={100}
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/logo:scale-105 transform-gpu"
            />
          </div>
        </div>

        <div class="min-w-0 flex-1 sm:border-l sm:border-[var(--color-border)] sm:pl-5">
          <p class="text-xs font-extrabold uppercase tracking-widest text-[var(--color-text)] sm:text-sm">
            Official EVENT PARTNERSHIP
          </p>
          <p class="mt-0.5 whitespace-pre-line text-xs font-medium text-[var(--color-text-muted)] sm:text-sm">
            {subtitle}
          </p>
        </div>
      </div>

      {/* Title & Copy */}
      <div class="mt-8 text-left">
        <h2
          id="flash-popup-title"
          class="text-3xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl md:leading-[1.1]"
        >
          {title}
        </h2>
        <p
          id="flash-popup-description"
          class="mt-5 text-base leading-relaxed text-[var(--color-text-muted)] sm:text-lg md:text-xl md:leading-relaxed"
        >
          {description}
        </p>
      </div>
    </main>

    {/* ================= FOOTER / ACTION BAR ================= */}
    <footer class="mt-10 flex flex-col gap-6 border-t border-[var(--color-border)] pt-8 sm:flex-row sm:items-center sm:justify-between">
      {/* Empty Left Indicator Area for Layout Balance */}
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]" aria-hidden="true">
        <span> </span>
      </div>

      {/* Tactile Interactive Buttons */}
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center">
        <button
          id="dismiss-flash-text"
          type="button"
          class="w-full rounded-xl border border-transparent px-6 py-3.5 text-sm font-semibold text-[var(--color-text-muted)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-[var(--color-border)] hover:bg-[var(--color-background)] hover:text-[var(--color-text)] active:scale-95 sm:w-auto transform-gpu"
        >
          Maybe Later
        </button>

        {/* Primary CTA Button -> Injected dynamically via script */}
        <a
          id="whatsapp-cta-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer preload"
          aria-label="Become an Industry Partner via WhatsApp"
          class="group relative inline-flex w-full items-center justify-center gap-2.5 overflow-hidden rounded-xl bg-[var(--color-accent)] px-8 py-4 text-sm font-bold text-white shadow-lg shadow-[var(--color-accent-glow)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:bg-[var(--color-accent-hover)] hover:shadow-xl hover:shadow-[var(--color-accent-glow)] active:scale-95 sm:w-auto transform-gpu"
        >
          <span
            class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 ease-out group-hover:translate-x-full"
            aria-hidden="true"
          ></span>

          {/* WhatsApp Logo SVG Icon */}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="relative z-10 h-5 w-5 shrink-0"
            aria-hidden="true"
          >
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.404.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.942 1.183.636.571 1.17.769 1.336.856.166.087.265.072.364-.043.098-.116.422-.491.534-.659.112-.168.224-.141.378-.087.154.055.979.462 1.148.548.169.087.282.13.324.202.043.072.043.419-.101.824zm-3.393-10.416c-5.414 0-9.813 4.399-9.813 9.813 0 1.93.568 3.733 1.554 5.253l-1.654 6.037 6.182-1.624c1.472.871 3.167 1.385 4.966 1.385 5.414 0 9.813-4.399 9.813-9.813 0-5.414-4.399-9.813-9.813-9.813z" />
          </svg>

          <span class="relative z-10">{ctaText}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
            class="relative z-10 h-4 w-4 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5 transform-gpu"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z"
            />
          </svg>
        </a>
      </div>
    </footer>
  </section>
</div>

{/* ================= MODAL LOGIC ================= */}
<script is:inline define:vars={{ delayMs }}>
  function initFlashPopup() {
    const modal = document.getElementById("flash-news-popup");
    const backdrop = document.getElementById("flash-popup-backdrop");
    const card = document.getElementById("flash-popup-card");
    const closeBtn = document.getElementById("close-flash-popup");
    const dismissTextBtn = document.getElementById("dismiss-flash-text");
    const whatsappBtn = document.getElementById("whatsapp-cta-btn");

    if (!modal || !backdrop || !card || !closeBtn || !dismissTextBtn) return;

    // --- SMART DEVICE ROUTER FOR WHATSAPP ---
    if (whatsappBtn) {
      const waPhone = "917598576406";
      const waText = encodeURIComponent("Hello, I am interested in partnering with IBM Qiskit Fall Fest 2026 at Bharathidasan University.");
      
      // Smart detection: Bypasses xdg-open issues on Desktop Linux/Windows by forcing web client
      const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      
      whatsappBtn.href = isMobile 
        ? `https://api.whatsapp.com/send?phone=${waPhone}&text=${waText}`
        : `https://web.whatsapp.com/send?phone=${waPhone}&text=${waText}`;
    }

    let previousActiveElement = null;

    const openModal = () => {
      if (window.__qryptex_flash_shown === true) return;
      window.__qryptex_flash_shown = true;

      // Trap focus
      previousActiveElement = document.activeElement;
      
      // Reveal visibility without layout shifts
      modal.classList.remove("invisible", "pointer-events-none", "opacity-0");
      modal.classList.add("opacity-100");

      requestAnimationFrame(() => {
        card.classList.remove("translate-y-8", "scale-90");
        card.classList.add("translate-y-0", "scale-100");
        closeBtn.focus();
      });

      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      window.__qryptex_flash_shown = true;

      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0", "pointer-events-none");
      card.classList.remove("translate-y-0", "scale-100");
      card.classList.add("translate-y-8", "scale-90");
      document.body.style.overflow = "";

      // Safely restore focus
      if (previousActiveElement && typeof previousActiveElement.focus === "function") {
        previousActiveElement.focus();
      }

      setTimeout(() => {
        modal.classList.add("invisible");
      }, 700);
    };

    // --- EVENT LISTENER CLEANUP & ATTACHMENT ---
    // Clone nodes to prevent duplicate listeners during Astro View Transitions
    const newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);

    const newDismissTextBtn = dismissTextBtn.cloneNode(true);
    dismissTextBtn.parentNode?.replaceChild(newDismissTextBtn, dismissTextBtn);

    const newBackdrop = backdrop.cloneNode(true);
    backdrop.parentNode?.replaceChild(newBackdrop, backdrop);

    newCloseBtn.addEventListener("click", closeModal);
    newDismissTextBtn.addEventListener("click", closeModal);
    newBackdrop.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("pointer-events-none")) {
        closeModal();
      }
    });

    // --- REFRESH-AWARE DISPLAY LOGIC ---
    // Resets on page reload (F5) but persists across Astro's internal view transitions
    if (window.__qryptex_flash_shown !== true) {
      const timer = setTimeout(openModal, delayMs);
      return () => clearTimeout(timer);
    } else {
      modal.classList.add("invisible");
    }
  }

  // Initialize on hard load and subsequent Astro page transitions
  initFlashPopup();
  document.addEventListener("astro:page-load", initFlashPopup);
</script>