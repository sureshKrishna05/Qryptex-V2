---
// src/components/navigation/FlashNews.astro
import { Image } from "astro:assets";
import { siteConfig } from "../../data/site";

// Import local assets from src/assets/
import bduLogo from "../../assets/bdu.png";
import qiskitLogo from "../../assets/qiskit-badge.png";

if (!siteConfig.flashNews?.enabled) {
  return;
}

const {
  title = siteConfig.flashNews.title || "Partner With Next-Gen Quantum Innovators",
  subtitle = "BDU × Qiskit Fallfest 2026 • Official Host & Partner Call",
  description = siteConfig.flashNews.description || "Bharathidasan University is officially hosting Qiskit Fallfest 2026—convening India's brightest engineering minds, researchers, and developers. Position your brand at the forefront of quantum computing and elite talent recruitment.",
  ctaText = siteConfig.flashNews.ctaText || "Claim Sponsorship Prospectus",
  href = siteConfig.flashNews.href || "/contact",
  delayMs = siteConfig.flashNews.delayMs || 800,
} = Astro.props;
---

<aside
  id="flash-news-popup"
  role="dialog"
  aria-modal="true"
  aria-labelledby="flash-popup-title"
  aria-describedby="flash-popup-description"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-600 ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu sm:p-6 md:p-10"
>
  {/* Glass Backdrop */}
  <div
    id="flash-popup-backdrop"
    class="absolute inset-0 bg-black/70 backdrop-blur-md transition-opacity duration-600 ease-[cubic-bezier(0.16,1,0.3,1)]"
    aria-hidden="true"
  ></div>

  {/* Modal Card */}
  <div
    id="flash-popup-card"
    class="relative z-10 w-full max-w-3xl translate-y-8 scale-90 overflow-hidden rounded-[2.5rem] border border-[var(--color-border)] bg-[var(--color-surface)]/95 p-6 shadow-2xl shadow-black/50 backdrop-blur-2xl transition-all duration-800 ease-[cubic-bezier(0.16,1,0.3,1)] sm:p-10 md:p-12 transform-gpu will-change-transform"
  >
    {/* Top Gold Accent Border */}
    <div
      class="absolute left-0 top-0 h-1.5 w-full bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-90"
      aria-hidden="true"
    ></div>

    {/* Clean Header & Tactile Dismiss Button */}
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
        </span>
        <span class="text-xs font-extrabold uppercase tracking-widest text-[var(--color-text-muted)]">
          Official Partnership Announcement
        </span>
      </div>

      <button
        id="close-flash-popup"
        type="button"
        aria-label="Close advertisement dialog"
        class="group flex h-11 w-11 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-text-muted)] shadow-xs transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-[var(--color-accent)] hover:bg-[var(--color-surface)] hover:text-[var(--color-text)] hover:shadow-md active:scale-90 transform-gpu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="h-5 w-5 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:rotate-90 transform-gpu"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    {/* CO-BRANDED PARTNERSHIP LOGO SHOWCASE */}
    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
      <div class="flex items-center gap-3.5">
        {/* BDU Logo Container */}
        <div class="group/logo flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-background)] p-2 shadow-sm transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-[var(--color-accent)]/60 hover:shadow-md sm:h-20 sm:w-20 transform-gpu">
          <Image
            src={bduLogo}
            alt="Bharathidasan University Logo"
            width={100}
            height={100}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-full w-full object-contain transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/logo:scale-105 transform-gpu"
          />
        </div>

        {/* Partnership Multiplier Icon */}
        <span class="text-xl font-light text-[var(--color-text-muted)] opacity-50" aria-hidden="true">
          ×
        </span>

        {/* Qiskit Fallfest Badge Container */}
        <div class="group/logo flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-background)] p-2 shadow-sm transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-[var(--color-accent)]/60 hover:shadow-md sm:h-20 sm:w-20 transform-gpu">
          <Image
            src={qiskitLogo}
            alt="Qiskit Fallfest 2026 Badge"
            width={100}
            height={100}
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-full w-full object-contain transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover/logo:scale-105 transform-gpu"
          />
        </div>
      </div>

      <div class="min-w-0 flex-1 sm:border-l sm:border-[var(--color-border)] sm:pl-5">
        <p class="text-xs font-extrabold uppercase tracking-widest text-[var(--color-text)] sm:text-sm">
          Official Host & Partner
        </p>
        <p class="mt-0.5 text-xs font-medium text-[var(--color-text-muted)] sm:text-sm">
          {subtitle}
        </p>
      </div>
    </div>

    {/* Title & Copy */}
    <div class="mt-8 text-left">
      <h2
        id="flash-popup-title"
        class="text-3xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-4xl md:text-5xl md:leading-[1.1]"
      >
        {title}
      </h2>
      <p
        id="flash-popup-description"
        class="mt-5 text-base leading-relaxed text-[var(--color-text-muted)] sm:text-lg md:text-xl md:leading-relaxed"
      >
        {description}
      </p>
    </div>

    {/* Action Bar */}
    <div class="mt-10 flex flex-col gap-6 border-t border-[var(--color-border)] pt-8 sm:flex-row sm:items-center sm:justify-between">
      {/* Bottom Metadata Tag */}
      <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
        <span class="h-2 w-2 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
        <span>Bharathidasan University • Q3 2026</span>
      </div>

      {/* Tactile Interactive Buttons */}
      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center">
        <button
          id="dismiss-flash-text"
          type="button"
          class="w-full rounded-xl border border-transparent px-6 py-3.5 text-sm font-semibold text-[var(--color-text-muted)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-[var(--color-border)] hover:bg-[var(--color-background)] hover:text-[var(--color-text)] active:scale-95 sm:w-auto transform-gpu"
        >
          Maybe Later
        </button>

        <a
          href={href}
          class="group relative inline-flex w-full items-center justify-center gap-2.5 overflow-hidden rounded-xl bg-[var(--color-accent)] px-8 py-4 text-sm font-bold text-white shadow-lg shadow-[var(--color-accent-glow)] transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:bg-[var(--color-accent-hover)] hover:shadow-xl hover:shadow-[var(--color-accent-glow)] active:scale-95 sm:w-auto transform-gpu"
        >
          <span
            class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 ease-out group-hover:translate-x-full"
            aria-hidden="true"
          ></span>

          <span class="relative z-10">{ctaText}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 16 16"
            fill="currentColor"
            class="relative z-10 h-4 w-4 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1.5 transform-gpu"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</aside>

<script is:inline define:vars={{ delayMs }}>
  function initFlashPopup() {
    const modal = document.getElementById("flash-news-popup");
    const backdrop = document.getElementById("flash-popup-backdrop");
    const card = document.getElementById("flash-popup-card");
    const closeBtn = document.getElementById("close-flash-popup");
    const dismissTextBtn = document.getElementById("dismiss-flash-text");

    if (!modal || !backdrop || !card || !closeBtn || !dismissTextBtn) return;

    // Show only once per browser reload/fresh session
    if (window.__flashPopupShownThisLoad) {
      modal.style.display = "none";
      return;
    }

    let previousActiveElement = null;

    const openModal = () => {
      if (window.__flashPopupShownThisLoad) return;
      window.__flashPopupShownThisLoad = true;

      previousActiveElement = document.activeElement;
      modal.style.display = "flex";

      // Double rAF ensures zero layout-shift before CSS transitions trigger
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          modal.classList.remove("pointer-events-none", "opacity-0");
          modal.classList.add("opacity-100");
          card.classList.remove("translate-y-8", "scale-90");
          card.classList.add("translate-y-0", "scale-100");

          // Manage focus for keyboard/screen-reader accessibility
          closeBtn.focus();
        });
      });

      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0", "pointer-events-none");
      card.classList.remove("translate-y-0", "scale-100");
      card.classList.add("translate-y-8", "scale-90");
      document.body.style.overflow = "";

      // Restore focus to the element that was active before the dialog opened
      if (previousActiveElement && typeof previousActiveElement.focus === "function") {
        previousActiveElement.focus();
      }

      setTimeout(() => {
        modal.style.display = "none";
      }, 700);
    };

    const newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);

    const newDismissTextBtn = dismissTextBtn.cloneNode(true);
    dismissTextBtn.parentNode?.replaceChild(newDismissTextBtn, dismissTextBtn);

    const newBackdrop = backdrop.cloneNode(true);
    backdrop.parentNode?.replaceChild(newBackdrop, backdrop);

    newCloseBtn.addEventListener("click", closeModal);
    newDismissTextBtn.addEventListener("click", closeModal);
    newBackdrop.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("pointer-events-none")) {
        closeModal();
      }
    });

    const timer = setTimeout(openModal, delayMs);
    return () => clearTimeout(timer);
  }

  initFlashPopup();
  document.addEventListener("astro:page-load", initFlashPopup);
</script>