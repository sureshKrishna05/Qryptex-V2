---
import { Image } from "astro:assets";
import logoImage from "../../assets/qryptex.jpeg";

import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
import { navigationLinks } from "../../data/navigation";
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-background)]/80 backdrop-blur-2xl transition-colors duration-[800ms] ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu">
  <Container>
    <nav aria-label="Main Navigation" class="flex h-20 items-center justify-between">

      <a 
        href="/" 
        class="group flex items-center gap-3 transition-transform duration-300 hover:-translate-y-0.5 transform-gpu"
        aria-label="Qryptex Home"
      >
        <div class="relative flex h-11 w-11 items-center justify-center overflow-hidden rounded-xl shadow-sm transition-all duration-[600ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:rotate-3 group-hover:shadow-[0_0_15px_var(--color-accent-glow)] transform-gpu">
          <Image 
            src={logoImage} 
            alt="Qryptex Logo" 
            width={88} 
            height={88}
            class="h-full w-full object-cover"
          />
        </div>

        <div>
          <p class="text-xl font-extrabold tracking-tight text-[var(--color-text)] transition-colors duration-300 group-hover:text-[var(--color-accent)]">
            Qryptex
          </p>
          <p class="hidden text-[10px] font-bold uppercase tracking-widest text-[var(--color-text-muted)] md:block">
            Security <span class="text-[var(--color-accent)]">First.</span>
          </p>
        </div>
      </a>

      <ul class="hidden items-center gap-8 lg:flex" aria-label="Desktop Navigation">
        {
          navigationLinks.map((item) => (
            <li>
              <a
                href={item.href}
                data-astro-reload={item.href.includes('#') ? true : undefined}
                class="relative text-sm font-bold tracking-wide text-[var(--color-text-muted)] transition-colors duration-300 hover:text-[var(--color-text)] after:absolute after:-bottom-1.5 after:left-0 after:h-[2px] after:w-0 after:rounded-full after:bg-[var(--color-accent)] after:transition-all after:duration-300 hover:after:w-full"
              >
                {item.label}
              </a>
            </li>
          ))
        }

        {/* UPGRADED: Desktop Live News Trigger */}
        <li>
          <button
            type="button"
            class="open-flash-news-btn group relative inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/50 px-3.5 py-1.5 text-sm font-bold tracking-wide text-[var(--color-text-muted)] transition-all duration-300 hover:border-[var(--color-accent)] hover:bg-[var(--color-surface)] hover:text-[var(--color-text)] active:scale-95"
            aria-label="View latest news and announcements"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span>
            </span>
            <span>News</span>
          </button>
        </li>
      </ul>

      <div class="hidden items-center gap-5 lg:flex">
        <ThemeToggle />

        <Button 
          href="/contact" 
          class="shadow-md shadow-[var(--color-accent-glow)] hover:scale-105 transition-transform duration-300 transform-gpu"
        >
          Let's Talk
        </Button>
      </div>

      <button
        id="menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open Mobile Menu"
        class="flex h-11 w-11 items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/50 text-[var(--color-text)] backdrop-blur-md transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-[var(--color-accent)]/50 hover:bg-[var(--color-surface)] active:scale-90 lg:hidden transform-gpu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>

    </nav>
  </Container>
</header>

<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation"
  class="fixed inset-0 z-[100] hidden"
>
  <div
    id="menu-overlay"
    class="absolute inset-0 bg-[var(--color-background)]/60 opacity-0 backdrop-blur-md transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <div
    id="mobile-drawer"
    class="absolute right-0 top-0 flex h-full w-[300px] max-w-[80vw] translate-x-full flex-col border-l border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xl transition-transform duration-[500ms] ease-[cubic-bezier(0.16,1,0.3,1)] transform-gpu"
  >
    
    <div class="flex items-center justify-between border-b border-[var(--color-border)] p-6">
      <h3 class="text-xs font-bold uppercase tracking-widest text-[var(--color-accent)]">
        Navigation
      </h3>

      <button
        id="close-menu"
        aria-label="Close Mobile Menu"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-background)] text-[var(--color-text-muted)] transition-all duration-300 hover:bg-[var(--color-border)] hover:text-[var(--color-text)] active:scale-90 transform-gpu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <ul class="flex flex-col gap-2 p-6" aria-label="Mobile Navigation Links">
      {
        navigationLinks.map((item) => (
          <li>
            <a
              href={item.href}
              data-astro-reload={item.href.includes('#') ? true : undefined}
              class="mobile-nav-link block rounded-xl px-4 py-3 text-lg font-bold text-[var(--color-text)] transition-colors duration-300 hover:bg-[var(--color-accent)]/10 hover:text-[var(--color-accent)]"
            >
              {item.label}
            </a>
          </li>
        ))
      }

      {/* UPGRADED: Mobile Drawer Live News Button */}
      <li>
        <button
          type="button"
          class="open-flash-news-btn mobile-nav-link flex w-full items-center justify-between rounded-xl px-4 py-3 text-lg font-bold text-[var(--color-text)] transition-colors duration-300 hover:bg-[var(--color-accent)]/10 hover:text-[var(--color-accent)]"
          aria-label="View latest news and announcements"
        >
          <span>News</span>
          <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-75"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[var(--color-accent)]"></span>
          </span>
        </button>
      </li>
    </ul>

    <div class="mt-auto border-t border-[var(--color-border)] bg-[var(--color-background)]/50 p-6">
      <div class="mb-6 flex items-center justify-between">
        <span class="text-sm font-medium text-[var(--color-text-muted)]">Theme</span>
        <ThemeToggle />
      </div>

      <Button href="/contact" class="w-full justify-center shadow-md shadow-[var(--color-accent-glow)] mobile-nav-link">
        Let's Talk
      </Button>
    </div>

  </div>
</div>

<script is:inline>
  function initMobileMenu() {
    const menu = document.getElementById("mobile-menu");
    const drawer = document.getElementById("mobile-drawer");
    const overlay = document.getElementById("menu-overlay");
    const openBtn = document.getElementById("menu-button");
    const closeBtn = document.getElementById("close-menu");
    const navLinks = document.querySelectorAll(".mobile-nav-link");

    if (!menu || !drawer || !overlay || !openBtn || !closeBtn) return;

    // Reset state and wipe old listeners for Astro page transitions
    const newOpenBtn = openBtn.cloneNode(true);
    openBtn.parentNode?.replaceChild(newOpenBtn, openBtn);
    
    const newCloseBtn = closeBtn.cloneNode(true);
    closeBtn.parentNode?.replaceChild(newCloseBtn, closeBtn);

    const openMenu = () => {
      menu.classList.remove("hidden");
      newOpenBtn.setAttribute("aria-expanded", "true");
      
      requestAnimationFrame(() => {
        overlay.classList.remove("opacity-0");
        drawer.classList.remove("translate-x-full");
      });
      
      document.body.style.overflow = "hidden";
    };

    const closeMenu = () => {
      overlay.classList.add("opacity-0");
      drawer.classList.add("translate-x-full");
      newOpenBtn.setAttribute("aria-expanded", "false");
      
      setTimeout(() => {
        menu.classList.add("hidden");
        document.body.style.overflow = ""; 
      }, 500); 
    };

    newOpenBtn.addEventListener("click", openMenu);
    newCloseBtn.addEventListener("click", closeMenu);
    overlay.addEventListener("click", closeMenu);

    // Auto-close menu when a link is clicked
    navLinks.forEach(link => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        closeMenu();
      }
    });
  }

  // UPGRADED: Script to wire the News button to re-open the FlashNews popup
  function initNewsButton() {
    const newsButtons = document.querySelectorAll(".open-flash-news-btn");
    const modal = document.getElementById("flash-news-popup");
    const card = document.getElementById("flash-popup-card");
    const closeBtn = document.getElementById("close-flash-popup");

    if (!newsButtons.length || !modal || !card) return;

    newsButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        modal.classList.remove("invisible", "pointer-events-none", "opacity-0");
        modal.classList.add("opacity-100");

        requestAnimationFrame(() => {
          card.classList.remove("translate-y-8", "scale-90");
          card.classList.add("translate-y-0", "scale-100");
          if (closeBtn) closeBtn.focus();
        });

        document.body.style.overflow = "hidden";
      });
    });
  }

  // Run on initial load
  initMobileMenu();
  initNewsButton();
  
  // Re-run safely after Astro page transitions
  document.addEventListener("astro:page-load", () => {
    initMobileMenu();
    initNewsButton();
  });
</script>