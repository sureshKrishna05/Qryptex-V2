---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
---

<BaseLayout
  title="403: Access Denied | Qryptex"
  description="You do not have permission to view this resource."
>
  <section class="section-light relative flex min-h-[80vh] items-center justify-center overflow-hidden py-32">
    
    <!-- Ambient Background Glow -->
    <div 
      class="pointer-events-none absolute left-1/2 top-1/2 -z-10 h-[600px] w-full max-w-3xl -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-accent-glow)] blur-[120px] transition-opacity duration-1000" 
      aria-hidden="true"
    ></div>

    <Container>
      <div class="group relative mx-auto max-w-3xl text-center">

        <div class="relative overflow-hidden rounded-[3rem] border border-[var(--color-border)] bg-[var(--color-surface)]/80 px-6 py-20 shadow-2xl shadow-[var(--color-accent-glow)] backdrop-blur-2xl sm:px-16 sm:py-24 transition-all duration-[800ms] ease-[cubic-bezier(0.16,1,0.3,1)] hover:shadow-2xl hover:shadow-[var(--color-accent-glow)] transform-gpu">
          
          <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-accent-glow)] to-transparent opacity-0 transition-opacity duration-700 group-hover:opacity-100 pointer-events-none"></div>

          <div class="relative z-10 flex flex-col items-center">
            
            <!-- Locked Shield Icon -->
            <div class="relative mb-10 flex h-24 w-24 items-center justify-center">
              <span class="absolute inline-flex h-full w-full animate-ping-once rounded-full border border-[var(--color-accent)] opacity-20 duration-[2000ms]"></span>
              <span class="absolute inline-flex h-3/4 w-3/4 animate-ping-once rounded-full border border-[var(--color-accent)] opacity-40 duration-[2000ms] delay-500"></span>
              
              <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--color-background)] border border-[var(--color-border)] text-[var(--color-accent)] shadow-inner transition-transform duration-500 group-hover:scale-110 transform-gpu">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
              </div>
            </div>

            <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">
              Error 403
            </span>

            <h1 class="mt-4 text-5xl font-extrabold tracking-tighter text-[var(--color-text)] md:text-7xl">
              Access <br />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)]">
                Denied.
              </span>
            </h1>

            <p class="mx-auto mt-6 max-w-lg text-lg leading-relaxed text-[var(--color-text-muted)]">
              You lack the necessary clearance to view this endpoint. Please verify your credentials or request access from an administrator.
            </p>

            <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
              <Button href="/contact" class="w-full sm:w-auto shadow-lg shadow-[var(--color-accent-glow)] group transform-gpu transition-all hover:scale-105">
                <span class="flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 transition-transform duration-300 group-hover:-translate-y-0.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                  </svg>
                  Request Clearance
                </span>
              </Button>

              <Button href="/" variant="secondary" class="w-full sm:w-auto transform-gpu transition-all hover:scale-105">
                Return to Base
              </Button>
            </div>

          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  @keyframes ping-once {
    0% { transform: scale(0.8); opacity: 0.5; }
    50% { opacity: 0.3; }
    100% { transform: scale(1.5); opacity: 0; }
  }
  .animate-ping-once {
    animation: ping-once 2s cubic-bezier(0, 0, 0.2, 1) forwards;
  }
</style>