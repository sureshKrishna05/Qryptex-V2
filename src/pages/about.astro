---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

// --- Data Objects for cleaner markup ---
const principles = [
  {
    title: "Security First",
    description: "Security isn't a plugin or an afterthought. It's integrated into our planning, architecture, development, and long-term operations.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`
  },
  {
    title: "Engineering Excellence",
    description: "We build maintainable, highly-scalable, and reliable systems designed specifically to support enterprise-grade business growth without technical debt.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" /></svg>`
  },
  {
    title: "Long-Term Value",
    description: "We reject short-term hacks. Every architectural decision we make is focused on measurable business outcomes, sustainability, and tangible ROI.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`
  }
];
---

<BaseLayout
  title="About Us | Security-First Engineering Partner"
  description="Learn about Qryptex's mission to engineer secure, scalable, and resilient technology platforms. Discover our core principles and engineering excellence."
>

  <section class="relative overflow-hidden section-light pt-16 pb-16 md:pt-24 md:pb-24 bg-[var(--color-background)]">
    <Container>
      <div class="relative mx-auto max-w-4xl text-center">

        <h1 class="text-5xl font-extrabold tracking-tight text-[var(--color-text)] md:text-7xl lg:leading-[1.1] transform-gpu isolate">
          Building Secure Technology <br class="hidden md:block" />
          <span class="inline-block pb-2 -mb-2 text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)]">For Modern Businesses</span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-text-muted)]">
          Qryptex is a security-first technology company helping organizations build bulletproof software, intelligent AI systems, and scalable digital platforms engineered for long-term growth.
        </p>

      </div>
    </Container>
  </section>

  <section class="section-light pb-32 bg-[var(--color-background)]">
    <Container>
      <div class="mx-auto max-w-6xl rounded-[2.5rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-xl shadow-[var(--color-border)]/50 md:p-16 lg:p-20 relative overflow-hidden">
        
        <div class="grid gap-12 lg:grid-cols-12 relative z-10">
          
          <div class="lg:col-span-5">
            <div class="sticky top-24">
              <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">Our Mission</span>
              <h2 class="mt-4 text-3xl font-bold text-[var(--color-text)] md:text-5xl leading-tight">
                Security Should Never Be An Afterthought.
              </h2>
            </div>
          </div>

          <div class="lg:col-span-7 space-y-8 text-lg leading-relaxed text-[var(--color-text-muted)] pt-4 lg:pt-0">
            <p>
              Technology drives modern business, but in the race to deploy faster, security is often introduced too late in the process. This creates massive risk, insurmountable technical debt, and unnecessary complexity.
            </p>
            <p>
              We believe organizations should be able to innovate rapidly with absolute confidence. That's why every single solution we design from enterprise AI integrations to custom web applications is built around security, scalability, and reliability from day one.
            </p>
            <div class="rounded-2xl bg-[var(--color-background)] p-8 border border-[var(--color-border)] shadow-sm relative overflow-hidden">
              <p class="font-medium text-[var(--color-text)] italic relative z-10">
                "Our goal is simple: help businesses adopt modern technology to accelerate growth without compromising trust, performance, or resilience."
              </p>
            </div>
          </div>

        </div>
        
      </div>
    </Container>
  </section>

  <section class="section-dark py-32 relative overflow-hidden">
    <Container>
      <div class="mx-auto max-w-3xl text-center mb-16 relative z-10">
        <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">What Guides Us</span>
        <h2 class="mt-4 text-4xl font-bold text-white md:text-5xl">
          Principles That Shape Every Project
        </h2>
        <p class="mt-4 text-lg text-slate-300">
          We don't compromise on our standards. These core tenets dictate how we architect, build, and deploy technology for our partners.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-3 relative z-10">
        {principles.map((principle) => (
          <article class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-accent)]/50 hover:bg-white/10 transform-gpu">
            <div class="relative z-10">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-black/30 text-[var(--color-accent)] ring-1 ring-white/10 transition-colors group-hover:bg-[var(--color-accent)] group-hover:text-white transform-gpu">
                <Fragment set:html={principle.icon} />
              </div>
              <h3 class="text-2xl font-bold text-white">{principle.title}</h3>
              <p class="mt-4 leading-relaxed text-slate-300">{principle.description}</p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="py-24 section-light bg-[var(--color-background)]">
    <Container>
      <div class="relative overflow-hidden rounded-[3rem] border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-20 text-center shadow-xl shadow-[var(--color-border)]/50 md:px-16 md:py-24 transform-gpu">
        
        <div class="relative z-10 mx-auto max-w-3xl">
          <h2 class="text-4xl font-bold text-[var(--color-text)] md:text-6xl transform-gpu isolate">
            Let's Build Something <br/>
            <span class="inline-block pb-1 -mb-1 text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)]">Secure</span>
          </h2>
          <p class="mx-auto mt-6 max-w-xl text-lg text-[var(--color-text-muted)]">
            Partner with Qryptex to engineer custom technology solutions designed fundamentally for resilience, scale, and uncompromising security.
          </p>
          <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a 
              href="/contact" 
              class="group flex w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-accent)] px-8 py-4 text-lg font-bold text-white transition-all hover:-translate-y-1 hover:bg-[var(--color-accent-hover)] shadow-lg sm:w-auto transform-gpu"
            >
              Get In Touch
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform group-hover:translate-x-1 transform-gpu" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </Container>
  </section>

</BaseLayout>