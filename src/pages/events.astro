---
// src/pages/events.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import { Image } from "astro:assets";

// Make sure you place your image at src/assets/events/jeganmatha-main.jpg
import jeganmathaImg from "../assets/events/jeganmatha-main.jpg";

const pastEvents = [
  {
    id: "quantum-jeganmatha",
    title: "Quantum Computing Basics",
    date: "August 2026",
    location: "Jeganmatha School, Trichy",
    image: jeganmathaImg,
    description: "An interactive session breaking down the fundamentals of quantum mechanics, qubits, and how quantum computing impacts modern cryptography.",
    topics: ["Quantum Basics", "Qubits", "Cryptography", "Future Tech"],
    galleryCount: 10
  }
];
const galleryFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/events/gallery/*.{jpeg,jpg,png}', { eager: true });
const galleryImages = Object.values(galleryFiles).map(file => file.default);
---

<BaseLayout title="Events & Training | Qryptex" description="View our past cybersecurity workshops and book a technical training session for your institution.">
  
  {/* HERO SECTION */}
  <section class="relative overflow-hidden section-light pt-32 pb-16">
    <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[400px] w-full max-w-4xl -translate-x-1/2 rounded-full bg-[var(--color-accent-glow)] blur-[100px]" aria-hidden="true"></div>
    
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-[var(--color-text)] md:text-6xl">
          Events & Training
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--color-text-muted)]">
          Real-world technical workshops, capture-the-flag (CTF) challenges, and cybersecurity seminars.
        </p>
      </div>
    </Container>
  </section>

  {/* PAST EVENTS ARCHIVE */}
  <section class="section-light py-16">
    <Container>
      <div class="mb-10 text-center md:text-left">
        <h2 class="text-3xl font-bold text-[var(--color-text)]">
          Past Events
        </h2>
      </div>

      <div class="mx-auto max-w-4xl">
        {pastEvents.map((event) => (
          <article class="group flex flex-col md:flex-row overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm transition-shadow hover:shadow-lg">
            
            {/* Event Photo - OPTIMIZED FOR SEO & PERFORMANCE */}
            <div class="relative h-64 md:h-auto md:w-2/5 overflow-hidden bg-[var(--color-background)] shrink-0">
              <Image 
                src={event.image} 
                alt={`Qryptex training event at ${event.location}`}
                width={800}
                format="webp"
                quality={80}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              
              {/* Image Overlay Metadata */}
              <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
                <div class="flex flex-col gap-2">
                  <span class="inline-flex w-fit items-center gap-1.5 rounded-md bg-[var(--color-accent)]/90 backdrop-blur-md px-2 py-1 text-[10px] font-extrabold uppercase tracking-wider text-white shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    {galleryImages.length} Photos
                  </span>
                  <span class="inline-flex w-fit items-center gap-1.5 rounded-md bg-black/50 backdrop-blur-md px-2.5 py-1 text-xs font-semibold text-white">
                    {event.date}
                  </span>
                </div>
                <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-200">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                  {event.location}
                </span>
              </div>
            </div>

            {/* Content & Topics */}
            <div class="p-8 md:p-10 flex flex-col justify-center w-full">
              <h3 class="text-2xl font-bold text-[var(--color-text)] mb-3">{event.title}</h3>
              <p class="text-[var(--color-text-muted)] leading-relaxed mb-6 text-sm">{event.description}</p>
              
              <div>
                <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--color-text)] mb-3 border-b border-[var(--color-border)] pb-2">
                  Topics Covered
                </h4>
                <ul class="flex flex-wrap gap-2">
                  {event.topics.map((topic) => (
                    <li class="rounded-md bg-[var(--color-background)] border border-[var(--color-border)] px-3 py-1.5 text-xs font-medium text-[var(--color-text-muted)]">
                      {topic}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

          </article>
        ))}
      </div>
    </Container>
  </section>
  {/* EVENT GALLERY */}
  {galleryImages.length > 0 && (
    <section class="section-light py-20 bg-[var(--color-surface)] border-y border-[var(--color-border)]">
      <Container>
        <div class="mb-12 text-center max-w-2xl mx-auto">
          <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">Gallery</span>
          <h2 class="mt-3 text-3xl font-bold text-[var(--color-text)] md:text-4xl">
            Jeganmatha School Event
          </h2>
          <p class="mt-4 text-lg text-[var(--color-text-muted)]">
            Glimpses from our recent Quantum Computing session at Jeganmatha School, Trichy.
          </p>
        </div>

        <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 gap-4 space-y-4">
          {galleryImages.map((img, index) => (
            <div class="group relative break-inside-avoid overflow-hidden rounded-2xl border border-[var(--color-border)] bg-[var(--color-background)] shadow-sm hover:shadow-xl transition-all duration-300">
              <Image 
                src={img} 
                alt={`Qryptex Event Highlight ${index + 1}`} 
                width={600} 
                format="webp"
                quality={80}
                class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}
  {/* UPCOMING / HOST A WORKSHOP CTA */}
  <section class="section-dark py-24 relative overflow-hidden border-t border-[var(--color-border)]">
    <Container>
      <div class="flex flex-col items-center justify-center rounded-[2rem] border border-dashed border-white/20 bg-white/5 px-6 py-16 text-center backdrop-blur-sm">
        <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        </div>
        <h2 class="text-3xl font-bold text-white">Host a Workshop</h2>
        <p class="mt-4 max-w-xl text-slate-300 leading-relaxed">
          We are actively scheduling our next round of technical training sessions. Contact us to request a custom cybersecurity or web3 engineering workshop at your institution or enterprise.
        </p>
        <a 
          href="/contact" 
          class="mt-8 rounded-xl bg-[var(--color-accent)] px-8 py-3.5 text-sm font-bold text-white shadow-lg transition-all hover:-translate-y-1 hover:bg-[var(--color-accent-hover)] hover:shadow-xl"
        >
          Book an Event
        </a>
      </div>
    </Container>
  </section>

</BaseLayout>