---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import Container from "../../components/ui/Container.astro";

// --- Data Objects for cleaner markup ---

const capabilities = [
  {
    title: "Enterprise RAG & Knowledge Systems",
    description: "Stop searching, start asking. Chat securely with your internal documents, wikis, and databases without leaking data to public models.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.015-.392.03-.59.045m0 0c-1.63.125-3.28.194-4.935.194-1.655 0-3.305-.069-4.935-.194m0 0c-.198-.015-.396-.03-.59-.045m0 0c-1.655-.125-3.28-.194-4.935-.194-1.655 0-3.305.069-4.935.194m0 0c-.198.015-.396.03-.59.045m8.526-7.854c.732.14 1.458.3 2.176.48m-2.176-.48A12.001 12.001 0 0012 3.5a12.001 12.001 0 00-4.636 1.485m4.636 10.137v4.5" /></svg>`
  },
  {
    title: "Autonomous Agents",
    description: "Deploy intelligent agents that don't just answer questions, but actively execute tasks—from customer onboarding to L1 technical support.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" /></svg>`
  },
  {
    title: "Document Intelligence",
    description: "Transform unstructured PDFs, invoices, and contracts into structured JSON data instantly using cutting-edge Vision models and OCR.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>`
  },
  {
    title: "Predictive Analytics",
    description: "Uncover hidden patterns in your data. We build machine learning pipelines that forecast trends, predict churn, and optimize resource allocation.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`
  },
];

const processSteps = [
  { name: "Strategic Discovery", desc: "Mapping AI to tangible business ROI." },
  { name: "Data & Security Audit", desc: "Ensuring your infrastructure is ready and safe." },
  { name: "Architecture & PoC", desc: "Rapid prototyping to prove technical viability." },
  { name: "Development & Tuning", desc: "Building, prompting, and fine-tuning models." },
  { name: "Red Team & Security", desc: "Rigorous adversarial testing before launch." },
  { name: "Deployment & Scale", desc: "Seamless rollout with ongoing monitoring." },
];
---

<ServiceLayout
  title="Secure Enterprise AI & Automation Solutions"
  badge="AI SOLUTIONS"
  description="Transform your operations with secure, scalable AI. We engineer private LLM integrations, document intelligence, and autonomous agent workflows."
>

  <!-- OVERVIEW SECTION -->
  <section class="relative overflow-hidden section-light pt-32 pb-24">
    <div class="pointer-events-none absolute right-0 top-0 -z-10 h-[500px] w-full max-w-3xl translate-x-1/3 rounded-full bg-[var(--color-accent-glow)] blur-[120px]" aria-hidden="true"></div>

    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-accent)] bg-[var(--color-accent-glow)] px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] shadow-sm">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span></span>
          Beyond The Hype
        </span>

        <h2 class="mt-8 text-4xl font-extrabold tracking-tight text-[var(--color-text)] md:text-6xl lg:leading-[1.1]">
          Don't just add AI. <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)]">Multiply Your Efficiency.</span>
        </h2>

        <div class="mx-auto mt-8 max-w-2xl space-y-6 text-lg leading-relaxed text-[var(--color-text-muted)]">
          <p>
            Off-the-shelf AI tools expose your corporate data and rarely fit your unique workflows. We engineer <strong>private, custom-tailored AI platforms</strong> designed to reduce operational bottlenecks by up to 70%.
          </p>
          <p>
            Whether it's automating thousands of customer inquiries or extracting data from complex unstructured documents, we build AI that pays for itself.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- CAPABILITIES SECTION -->
  <section class="relative z-10 section-light pb-32">
    <Container>
      <div class="mb-16 md:flex md:items-end md:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-bold text-[var(--color-text)] md:text-5xl">
            High-Impact AI Capabilities
          </h2>
          <p class="mt-4 text-[var(--color-text-muted)] text-lg">
            We focus strictly on use-cases that directly impact your bottom line, productivity, or customer experience.
          </p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {capabilities.map((item) => (
          <article class="group relative overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-accent)] hover:shadow-xl">
            <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-accent-glow)] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            
            <div class="relative z-10">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--color-background)] text-[var(--color-accent)] ring-1 ring-[var(--color-border)] transition-colors group-hover:bg-[var(--color-accent)] group-hover:text-white">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-2xl font-bold text-[var(--color-text)]">{item.title}</h3>
              <p class="mt-4 leading-relaxed text-[var(--color-text-muted)]">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- WHY QRYPTEX (Trust & Security) -->
  <section class="section-dark py-32">
    <Container>
      <div class="grid gap-16 lg:grid-cols-2 lg:items-center">
        
        <div>
          <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">The Qryptex Advantage</span>
          <h2 class="mt-4 text-4xl font-bold text-white md:text-5xl leading-tight">
            Enterprise AI, Without The Data Leaks.
          </h2>
          <p class="mt-6 text-lg text-slate-300 leading-relaxed">
            As a cybersecurity-first engineering firm, we understand that feeding your intellectual property into public AI models is not an option. 
          </p>
          
          <ul class="mt-8 space-y-5">
            {[
              "Zero Data Retention: Your data is never used to train public models.",
              "VPC Deployments: AI hosted entirely within your secure cloud environment.",
              "Hallucination Mitigation: Guardrails built into the architecture.",
              "Measurable ROI: Systems built around KPIs, not just cool tech."
            ].map(listItem => (
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="mt-1 h-6 w-6 shrink-0 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-slate-200">{listItem}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="relative rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-md lg:p-12">
          <div class="absolute -right-10 -top-10 -z-10 h-64 w-64 rounded-full bg-[var(--color-accent)] opacity-20 blur-[80px]"></div>
          <div class="space-y-6">
            <div class="flex items-center justify-between border-b border-white/10 pb-6">
              <div>
                <div class="text-sm text-slate-400">Security Standard</div>
                <div class="mt-1 text-xl font-semibold text-white">SOC 2 & GDPR Aligned Architecture</div>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-accent)]/20 text-[var(--color-accent)]">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
              </div>
            </div>
            <div class="flex items-center justify-between border-b border-white/10 pb-6">
              <div>
                <div class="text-sm text-slate-400">Deployment</div>
                <div class="mt-1 text-xl font-semibold text-white">Private Cloud / On-Premises</div>
              </div>
            </div>
             <div class="flex items-center justify-between">
              <div>
                <div class="text-sm text-slate-400">Performance</div>
                <div class="mt-1 text-xl font-semibold text-white">High Throughput, Low Latency</div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- PROCESS SECTION -->
  <section class="section-light py-32">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">Our Methodology</span>
        <h2 class="mt-4 text-3xl font-bold text-[var(--color-text)] md:text-5xl">
          The Path to Production
        </h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)]">We don't build toys. We build enterprise-grade software using a rigorous, battle-tested engineering framework.</p>
      </div>

      <div class="mt-20 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {processSteps.map((step, index) => (
          <div class="relative rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-sm">
            <div class="absolute -top-5 left-8 flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-accent)] text-sm font-bold text-white shadow-lg shadow-[var(--color-accent-glow)]">
              0{index + 1}
            </div>
            <h3 class="mt-4 text-xl font-bold text-[var(--color-text)]">{step.name}</h3>
            <p class="mt-2 text-[var(--color-text-muted)]">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

</ServiceLayout>