---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import Container from "../../components/ui/Container.astro";

// --- Data Objects for cleaner markup ---

const capabilities = [
  {
    title: "Internal Business Platforms",
    description: "Custom ERPs and management systems designed specifically for your operational quirks, eliminating the need for scattered spreadsheets.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>`
  },
  {
    title: "Workflow Automation",
    description: "Replace manual, repetitive tasks with intelligent, event-driven workflows that save thousands of human hours and reduce error rates.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>`
  },
  {
    title: "Executive Dashboards",
    description: "Consolidate your business data into clean, real-time visual dashboards, giving leadership complete visibility into KPIs at a glance.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`
  },
  {
    title: "Customer & Partner Portals",
    description: "Secure, branded portals that allow your clients and vendors to interact with your business, access documents, and track services 24/7.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>`
  },
  {
    title: "Legacy System Integration",
    description: "We build robust API middleware to connect your old, siloed on-premise software with modern cloud-based tools.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" /></svg>`
  },
  {
    title: "Data & BI Pipelines",
    description: "Extract, transform, and load (ETL) your scattered data into secure data lakes, ready for advanced querying and machine learning.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>`
  }
];

const benefits = [
  {
    title: "Absolute Flexibility",
    description: "Technology that bends to your business, not the other way around. No forced workflows, no unnecessary features.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 7.756a4.5 4.5 0 100 8.488M7.5 10.5h5.25m-5.25 3h5.25M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  },
  {
    title: "Ruthless Efficiency",
    description: "Eliminate manual data entry, reduce human error, and automate the mundane so your team can focus on high-leverage work.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`
  },
  {
    title: "Competitive Advantage",
    description: "You can't outperform your competitors if you're using the exact same off-the-shelf software. Build a unique operational moat.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`
  }
];
---

<ServiceLayout
  title="Custom Enterprise Platforms & Workflow Automation"
  badge="CUSTOM TECHNOLOGY SOLUTIONS"
  description="Escape off-the-shelf limitations. We architect bespoke business platforms, custom internal tooling, and automated workflows designed for your enterprise."
>

  <!-- OVERVIEW / HERO SECTION -->
  <section class="relative overflow-hidden section-light pt-32 pb-24">
    <!-- Ambient Top Glow -->
    <div class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[500px] w-full max-w-4xl -translate-x-1/2 rounded-full bg-[var(--color-accent-glow)] blur-[120px]" aria-hidden="true"></div>

    <Container>
      <div class="mx-auto max-w-4xl text-center">
        
        <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-accent)] bg-[var(--color-accent-glow)] px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] shadow-sm">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--color-accent)] opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--color-accent)]"></span></span>
          Custom Engineering
        </span>

        <h2 class="mt-8 text-4xl font-extrabold tracking-tight text-[var(--color-text)] md:text-6xl lg:leading-[1.1]">
          Stop adapting your business to <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)]">off-the-shelf software.</span>
        </h2>

        <div class="mx-auto mt-8 max-w-2xl space-y-6 text-lg leading-relaxed text-[var(--color-text-muted)]">
          <p>
            Most software forces businesses to change their proven processes. We take the exact opposite approach by architecting technology strictly around your workflows, goals, and operational bottlenecks.
          </p>
          <p>
            From proprietary internal platforms to massive workflow automation systems, every solution we engineer is designed to pay for itself through extreme efficiency and long-term scalability.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <!-- CAPABILITIES SECTION -->
  <section class="relative z-10 section-light pb-32">
    <Container>
      <div class="mb-16 text-center">
        <h2 class="text-3xl font-bold text-[var(--color-text)] md:text-5xl">
          What We Build
        </h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          We don't build generic websites. We engineer robust digital tools that serve as the operational backbone of your organization.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {capabilities.map((item) => (
          <article class="group relative overflow-hidden rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-accent)] hover:shadow-xl">
            <!-- Subtle hover gradient inside card -->
            <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-accent-glow)] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            
            <div class="relative z-10">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--color-background)] text-[var(--color-accent)] ring-1 ring-[var(--color-border)] transition-colors group-hover:bg-[var(--color-accent)] group-hover:text-white">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-xl font-bold text-[var(--color-text)]">{item.title}</h3>
              <p class="mt-3 leading-relaxed text-[var(--color-text-muted)] text-sm">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- BUSINESS VALUE / ROI (DARK SECTION) -->
  <section class="section-dark py-32 relative overflow-hidden">
    <!-- Dark Mode Glow -->
    <div class="absolute left-0 top-1/2 -z-10 h-[600px] w-[600px] -translate-y-1/2 -translate-x-1/3 rounded-full bg-[var(--color-accent)] opacity-10 blur-[150px]"></div>

    <Container>
      <div class="grid gap-16 lg:grid-cols-12 lg:items-center">
        
        <div class="lg:col-span-5">
          <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">Business Value</span>
          <h2 class="mt-4 text-4xl font-bold text-white md:text-5xl leading-tight">
            Why Custom Software Wins.
          </h2>
          <p class="mt-6 text-lg text-slate-300 leading-relaxed">
            While SaaS products are great for general use cases, they become expensive and restrictive when your business scales or your processes become specialized. Custom technology changes the math entirely.
          </p>
        </div>

        <div class="lg:col-span-7 grid gap-6 sm:grid-cols-1">
          {benefits.map((benefit, index) => (
            <article class="flex items-start gap-6 rounded-3xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-colors hover:bg-white/10 hover:border-white/20">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-[var(--color-accent)]/20 text-[var(--color-accent)]">
                <Fragment set:html={benefit.icon} />
              </div>
              <div>
                <h3 class="text-xl font-bold text-white flex items-center gap-3">
                  <span class="text-[var(--color-accent)] font-mono text-sm opacity-70">0{index + 1}</span>
                  {benefit.title}
                </h3>
                <p class="mt-2 text-slate-300 leading-relaxed">{benefit.description}</p>
              </div>
            </article>
          ))}
        </div>

      </div>
    </Container>
  </section>

  <!-- PROCESS SECTION -->
  <section class="section-light py-32">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">Our Approach</span>
        <h2 class="mt-4 text-3xl font-bold text-[var(--color-text)] md:text-5xl">
          From Whiteboard to Deployment
        </h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)]">Building custom software shouldn't feel like a black box. We use a highly collaborative, iterative approach to ensure what we build is exactly what you need.</p>
      </div>

      <div class="mt-20 relative">
        <!-- Connecting Line for desktop -->
        <div class="hidden lg:block absolute top-12 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-30"></div>
        
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {[
            { name: "Strategic Discovery", desc: "We map out your workflows, identify bottlenecks, and define clear success metrics." },
            { name: "Architecture & UX", desc: "Prototyping interfaces and designing the database structure for maximum scalability." },
            { name: "Agile Engineering", desc: "Transparent, sprint-based coding with regular demos so you see progress instantly." },
            { name: "Launch & Iterate", desc: "Rigorous testing followed by a seamless deployment and ongoing optimization." }
          ].map((step, index) => (
            <article class="relative pt-8 text-center z-10 group">
              <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--color-surface)] text-2xl font-bold text-[var(--color-accent)] ring-2 ring-[var(--color-border)] transition-all group-hover:ring-[var(--color-accent)] shadow-sm">
                0{index + 1}
              </div>
              <h3 class="text-xl font-bold text-[var(--color-text)]">{step.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{step.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>

</ServiceLayout>