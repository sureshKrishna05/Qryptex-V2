---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import Container from "../../components/ui/Container.astro";

// --- Data Objects for cleaner markup ---

const threats = [
  {
    title: "Expanding Attack Surface",
    description: "Cloud migrations, third-party APIs, and remote workforces have eroded the traditional network perimeter.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>`
  },
  {
    title: "Evolving Threat Actors",
    description: "Automated exploits, ransomware-as-a-service, and AI-driven phishing attacks require proactive, dynamic defense strategies.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
  },
  {
    title: "Severe Business Impact",
    description: "A single breach can result in crippling operational downtime, regulatory fines, and irreparable damage to brand trust.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941" /></svg>`
  }
];

const capabilities = [
  {
    title: "Application Security & DevSecOps",
    description: "Shift left. We integrate automated vulnerability scanning, SAST/DAST, and secure coding practices directly into your CI/CD pipelines.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0020.25 18V6A2.25 2.25 0 0018 3.75H6A2.25 2.25 0 003.75 6v12A2.25 2.25 0 006 20.25z" /></svg>`
  },
  {
    title: "Cloud Infrastructure Posture",
    description: "Lock down AWS, Azure, or GCP. We resolve misconfigurations, enforce least-privilege IAM, and deploy hardened virtual private clouds.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" /></svg>`
  },
  {
    title: "Penetration Testing & Red Teaming",
    description: "Think like an attacker. Our offensive security engineers simulate real-world attacks to find critical exploitable paths before criminals do.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.82 1.508-2.316a7.5 7.5 0 10-7.516 0c.85.496 1.508 1.333 1.508 2.316V18" /></svg>`
  },
  {
    title: "Zero Trust Architecture",
    description: "Never trust, always verify. We architect environments where lateral movement is restricted, drastically limiting the blast radius of any breach.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`
  },
];
---
<ServiceLayout
  title="Enterprise Cybersecurity Services"
  badge="CYBERSECURITY SERVICES"
  description="Fortify your digital infrastructure with Qryptex. We provide zero-trust architecture, cloud security posture management, and DevSecOps integration."
>

  <section class="relative overflow-hidden section-light pt-32 pb-24">
    <div class="pointer-events-none absolute left-0 top-0 -z-10 h-[500px] w-full max-w-3xl -translate-x-1/3 rounded-full bg-[var(--color-accent-glow)] blur-[120px]" aria-hidden="true"></div>

    <Container>
      <div class="mx-auto max-w-4xl text-center">
        
        <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-accent)] bg-[var(--color-accent-glow)] px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-[var(--color-accent)] shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.95 11.95 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          Enterprise Protection
        </span>

        <h2 class="mt-8 text-4xl font-extrabold tracking-tight text-[var(--color-text)] md:text-6xl lg:leading-[1.1]">
          Security that accelerates <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)]">innovation, not bottlenecks.</span>
        </h2>

        <div class="mx-auto mt-8 max-w-2xl space-y-6 text-lg leading-relaxed text-[var(--color-text-muted)]">
          <p>
            In modern engineering, security cannot be an afterthought tacked on before deployment. We build <strong>secure-by-design</strong> environments that drastically reduce risk without compromising your team's agility.
          </p>
          <p>
            From deep-dive penetration testing to automated cloud governance, we protect your intellectual property so you can focus on scaling your business.
          </p>
        </div>

      </div>
    </Container>
  </section>

  <section class="relative z-10 section-light pb-32">
    <Container>
      <div class="mb-16 text-center">
        <h2 class="text-3xl font-bold text-[var(--color-text)] md:text-5xl">
          Modern Threats Require Modern Defense
        </h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)] max-w-2xl mx-auto">
          The stakes have never been higher. Legacy firewalls and periodic compliance checkboxes are no longer enough to stop sophisticated adversaries.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        {threats.map((threat) => (
          <article class="group rounded-3xl border border-[var(--color-border)] bg-transparent p-8 transition-colors duration-300 hover:bg-[var(--color-surface)] hover:shadow-lg hover:border-[var(--color-accent)]">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-accent-glow)] text-[var(--color-accent)]">
              <Fragment set:html={threat.icon} />
            </div>
            <h3 class="text-xl font-bold text-[var(--color-text)]">{threat.title}</h3>
            <p class="mt-3 text-[var(--color-text-muted)] leading-relaxed">{threat.description}</p>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="section-dark py-32 relative overflow-hidden">
    <div class="absolute left-1/2 top-1/2 -z-10 h-[800px] w-[800px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[var(--color-accent)] opacity-10 blur-[150px]"></div>

    <Container>
      <div class="mb-16 md:flex md:items-end md:justify-between">
        <div class="max-w-2xl">
          <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">Core Capabilities</span>
          <h2 class="mt-4 text-4xl font-bold text-white md:text-5xl">
            Offensive & Defensive Security
          </h2>
          <p class="mt-4 text-lg text-slate-300">
            We cover the entire security spectrum—from proactively hunting vulnerabilities to architecting bulletproof infrastructure.
          </p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        {capabilities.map((item) => (
          <article class="group relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 hover:border-[var(--color-accent)] hover:bg-white/10">
            <div class="relative z-10">
              <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-black/30 text-[var(--color-accent)] ring-1 ring-white/10 transition-colors group-hover:bg-[var(--color-accent)] group-hover:text-white">
                <Fragment set:html={item.icon} />
              </div>
              <h3 class="text-2xl font-bold text-white">{item.title}</h3>
              <p class="mt-4 leading-relaxed text-slate-300">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="section-light py-32">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">The Qryptex Framework</span>
        <h2 class="mt-4 text-3xl font-bold text-[var(--color-text)] md:text-5xl">
          Continuous Security Lifecycle
        </h2>
        <p class="mt-4 text-lg text-[var(--color-text-muted)]">Security is a moving target. We implement a continuous, iterative framework aligned with industry standards like NIST and ISO 27001.</p>
      </div>

      <div class="mt-20 relative">
        <div class="hidden lg:block absolute top-1/2 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-30 -translate-y-1/2"></div>
        
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
          {[
            { phase: "Assess", desc: "Identify critical assets, audit current architecture, and run deep-dive penetration tests." },
            { phase: "Harden", desc: "Remediate vulnerabilities, patch zero-days, and lock down identity access controls." },
            { phase: "Monitor", desc: "Deploy automated tooling to continuously scan repositories and infrastructure." },
            { phase: "Respond", desc: "Establish incident response playbooks to react instantly if a perimeter is breached." }
          ].map((step, index) => (
            <article class="relative rounded-[2rem] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 text-center shadow-sm z-10">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--color-background)] text-2xl font-bold text-[var(--color-accent)] ring-1 ring-[var(--color-border)] shadow-inner">
                {index + 1}
              </div>
              <h3 class="mt-6 text-xl font-bold text-[var(--color-text)]">{step.phase}</h3>
              <p class="mt-3 text-sm text-[var(--color-text-muted)]">{step.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="section-dark py-32">
    <Container>
      <div class="grid gap-16 lg:grid-cols-12 lg:items-center">
        
        <div class="lg:col-span-5">
          <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)]">Why Partner With Us</span>
          <h2 class="mt-4 text-4xl font-bold text-white md:text-5xl leading-tight">
            Engineering Trust Into Your Brand.
          </h2>
          <p class="mt-6 text-lg text-slate-300 leading-relaxed">
            A proactive security posture isn't just about avoiding disaster—it's a competitive advantage that wins enterprise deals and satisfies strict compliance audits.
          </p>
        </div>

        <div class="lg:col-span-7 grid gap-6 sm:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
            <div class="text-[var(--color-accent)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-white">Compliance Readiness</h3>
            <p class="mt-3 text-slate-300 text-sm">Achieve and maintain SOC 2, ISO 27001, HIPAA, or GDPR compliance seamlessly.</p>
          </div>

          <div class="rounded-3xl border border-[var(--color-accent)]/30 bg-[var(--color-accent)]/5 p-8 relative overflow-hidden">
            <div class="absolute -right-4 -top-4 h-24 w-24 rounded-full bg-[var(--color-accent)] opacity-20 blur-2xl"></div>
            <div class="text-[var(--color-accent)] mb-4">
               <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-white">Accelerated Velocity</h3>
            <p class="mt-3 text-slate-300 text-sm">Automated CI/CD security checks prevent bottlenecks, letting developers ship faster.</p>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-8 sm:col-span-2 text-center flex flex-col items-center">
            <div class="text-[var(--color-accent)] mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>
            </div>
            <h3 class="text-xl font-bold text-white">Guaranteed Resilience</h3>
            <p class="mt-3 text-slate-300 text-sm max-w-md">Eliminate single points of failure and architect for high-availability to prevent costly enterprise downtime.</p>
          </div>
        </div>

      </div>
    </Container>
  </section>

</ServiceLayout>