---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

const lastUpdated = "June 7, 2026";
---

<BaseLayout
  title="Terms & Policies | Qryptex"
  description="Read the Qryptex terms of service, privacy policy, and legal guidelines. We are committed to transparency and data security."
>
<section class="section-light relative overflow-hidden pt-16 pb-16 md:pt-20 md:pb-20">    
    <div 
      class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[400px] w-full max-w-5xl -translate-x-1/2 rounded-full bg-[var(--color-accent-glow)] blur-[100px]"
      aria-hidden="true"
    ></div>

    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-4xl font-extrabold tracking-tight text-[var(--color-text)] md:text-6xl">
          Legal & <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)]">Policies</span>
        </h1>
        <p class="mt-6 text-lg text-[var(--color-text-muted)]">
          Transparency and security are at the core of everything we do. <br class="hidden md:block" />
          Below you will find our commitments to you and the rules that govern our services.
        </p>
        <div class="mt-8">
          <span class="inline-block rounded-full bg-[var(--color-surface)] border border-[var(--color-border)] px-4 py-1.5 text-sm font-medium text-[var(--color-text-muted)] shadow-sm">
            Last Updated: {lastUpdated}
          </span>
        </div>
      </div>
    </Container>
  </section>

  <section class="section-light relative z-10 pb-32">
    <Container>
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-12 lg:flex-row">
        
        <aside class="w-full lg:sticky lg:top-32 lg:w-1/4 shrink-0">
          <nav class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 shadow-sm">
            <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-[var(--color-accent)]">
              Contents
            </h3>
            <ul class="flex flex-col gap-3">
              <li>
                <a href="#terms" class="block text-sm font-semibold text-[var(--color-text)] transition-colors hover:text-[var(--color-accent)]">
                  Terms of Service
                </a>
              </li>
              <li>
                <a href="#privacy" class="block text-sm font-semibold text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]">
                  Privacy Policy
                </a>
              </li>
              <li>
                <a href="#cookies" class="block text-sm font-semibold text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]">
                  Cookie Policy
                </a>
              </li>
              <li>
                <a href="#contact" class="block text-sm font-semibold text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]">
                  Contact Information
                </a>
              </li>
            </ul>
          </nav>
        </aside>

        <div class="w-full lg:w-3/4 rounded-3xl border border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-sm md:p-12">
          
          <div class="prose max-w-none text-[var(--color-text-muted)] prose-headings:text-[var(--color-text)] prose-headings:font-bold prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline prose-strong:text-[var(--color-text)]">
            
            <div id="terms" class="scroll-mt-32">
              <h2 class="text-3xl mb-6 border-b border-[var(--color-border)] pb-4">1. Terms of Service</h2>
              
              <h3 class="text-xl mt-8 mb-4">1.1 Agreement to Terms</h3>
              <p class="mb-6 leading-relaxed">
                By accessing our website at <a href="https://qryptex.in">qryptex.in</a>, you are agreeing to be bound by these terms of service, all applicable laws and regulations, and agree that you are responsible for compliance with any applicable local laws.
              </p>

              <h3 class="text-xl mt-8 mb-4">1.2 Intellectual Property</h3>
              <p class="mb-6 leading-relaxed">
                The materials contained in this website, including but not limited to software architectures, AI workflows, designs, text, and graphics, are protected by applicable copyright and trademark law. You may not copy, modify, distribute, or reproduce any content without explicit written permission from Qryptex.
              </p>

              <h3 class="text-xl mt-8 mb-4">1.3 Disclaimer</h3>
              <p class="mb-10 leading-relaxed">
                The materials on Qryptex's website are provided on an 'as is' basis. Qryptex makes no warranties, expressed or implied, and hereby disclaims and negates all other warranties including, without limitation, implied warranties or conditions of merchantability, fitness for a particular purpose, or non-infringement of intellectual property or other violation of rights.
              </p>
            </div>

            <div id="privacy" class="scroll-mt-32 pt-10">
              <h2 class="text-3xl mb-6 border-b border-[var(--color-border)] pb-4">2. Privacy Policy</h2>
              
              <p class="mb-6 leading-relaxed">
                Your privacy is critical to us. As a cybersecurity-first organization, we employ strict data minimization practices. We only collect the information absolutely necessary to provide our services and communicate with you effectively.
              </p>

              <h3 class="text-xl mt-8 mb-4">2.1 Data We Collect</h3>
              <ul class="mb-6 list-disc pl-6 space-y-2">
                <li><strong>Contact Information:</strong> Name, email address, and company details provided via our secure contact forms.</li>
                <li><strong>Technical Data:</strong> Anonymized usage data, IP addresses (temporarily for security monitoring), and browser types to ensure platform stability.</li>
              </ul>

              <h3 class="text-xl mt-8 mb-4">2.2 How We Use Data</h3>
              <p class="mb-10 leading-relaxed">
                We use the collected data strictly for communicating project scopes, providing technical support, and improving our digital infrastructure. <strong>We do not sell, rent, or lease your personal data to third parties.</strong>
              </p>
            </div>

            <div id="cookies" class="scroll-mt-32 pt-10">
              <h2 class="text-3xl mb-6 border-b border-[var(--color-border)] pb-4">3. Cookie Policy</h2>
              
              <p class="mb-6 leading-relaxed">
                We use strictly necessary cookies to ensure the basic functionality of the website and to enhance your experience. These do not track your personal activities across other sites.
              </p>
              <p class="mb-10 leading-relaxed">
                You can choose to disable cookies through your browser options. However, this may affect how you are able to interact with our site and services.
              </p>
            </div>

            <div id="contact" class="scroll-mt-32 pt-10">
              <h2 class="text-3xl mb-6 border-b border-[var(--color-border)] pb-4">4. Contact Us</h2>
              
              <p class="mb-6 leading-relaxed">
                If you have any questions about these Terms, our Privacy Policy, or how we handle data security, please contact our administrative team:
              </p>
              
              <div class="rounded-2xl bg-[var(--color-background)] p-6 border border-[var(--color-border)]">
                <p class="m-0"><strong>Email:</strong> <a href="mailto:contact@qryptex.in">contact@qryptex.in</a></p>
                <p class="m-0 mt-2"><strong>Response Time:</strong> Within 24-48 hours</p>
              </div>
            </div>

          </div>
        </div>

      </div>
    </Container>
  </section>

</BaseLayout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          document.querySelectorAll('aside nav a').forEach(link => {
            link.classList.remove('text-[var(--color-accent)]');
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('text-[var(--color-accent)]');
              link.classList.remove('text-[var(--color-text-muted)]');
            } else {
              link.classList.add('text-[var(--color-text-muted)]');
            }
          });
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });

    document.querySelectorAll('div[id]').forEach((section) => {
      observer.observe(section);
    });
  });
</script>