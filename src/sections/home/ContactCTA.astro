---
import Container from "../../components/ui/Container.astro";
import Button from "../../components/ui/Button.astro";
---

<section class="section-light relative py-32 lg:py-40">

  <Container class="relative z-10">

    <div class="relative overflow-hidden rounded-[40px] border border-[var(--color-border)] bg-[var(--color-surface)] p-12 shadow-2xl shadow-[var(--color-border)]/50 lg:p-24 transform-gpu">

      <div class="relative z-10 mx-auto max-w-4xl text-center">

        <h2 class="text-4xl font-extrabold tracking-tight text-[var(--color-text)] sm:text-5xl md:text-6xl lg:text-7xl lg:leading-[1.1] transform-gpu isolate">
          Secure Technology Starts
          <br />
          <span class="inline-block pb-2 -mb-2 bg-gradient-to-r from-[var(--color-accent)] to-[var(--color-accent-hover)] bg-clip-text text-transparent">
            With The Right Partner.
          </span>
        </h2>

        <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-[var(--color-text-muted)] sm:text-xl">
          Whether you're planning a secure software platform, AI-powered solutions, or a complex custom technology initiative, we're ready to engineer it.
        </p>

        <div class="mt-12 flex flex-col items-center justify-center gap-5 sm:flex-row">

          <Button href="/contact">
            Schedule a Consultation
          </Button>

          <Button href="/#services" variant="secondary">
            Explore Services
          </Button>

        </div>

      </div>

    </div>

  </Container>
</section>