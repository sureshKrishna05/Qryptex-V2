---
import Container from "../../components/ui/Container.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import { services } from "../../data/services";

const premiumIcons: Record<string, string> = {
  "cybersecurity": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>`,
  "ai-solutions": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09l2.846.813-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" /></svg>`,
  "software-engineering": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" /></svg>`,
  "custom-technology-solutions": `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a4.498 4.498 0 0 1-2.247 3.781 4.5 4.5 0 0 1-3.143.51m0 0a4.5 4.5 0 0 1-3.444-2.73m3.444 2.73a4.498 4.498 0 0 1 2.247-3.781 4.5 4.5 0 0 1 3.143-.51m-3.143-.51a4.5 4.5 0 0 1-2.73 3.444M9.63 8.41a4.5 4.5 0 0 1-3.444 2.73M9.63 8.41a4.498 4.498 0 0 1 2.247-3.781 4.5 4.5 0 0 1 3.143-.51m-3.143-.51a4.5 4.5 0 0 1 2.73 3.444" /></svg>`
};
---

<section
  id="services"
  aria-label="Our Core Capabilities"
  class="relative overflow-hidden py-32 lg:py-40"
>

  <Container class="relative z-10">

    <SectionHeading
      eyebrow="OUR CAPABILITIES"
      title="Security, AI & Engineering Expertise"
      description="Technology solutions designed to help organizations build, secure, automate, and scale."
    />

    <div class="mt-16 grid gap-8 md:grid-cols-2 lg:gap-10">

      {
        services.map((service) => (
          <a
            href={`/services/${service.slug}`}
            class="group relative flex flex-col overflow-hidden rounded-[32px] border border-[var(--color-border)] bg-[var(--color-surface)] p-8 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-2 hover:border-[var(--color-accent)]/40 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_20px_40px_-15px_rgba(255,255,255,0.02)] sm:p-10 transform-gpu"
          >
            
            <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-accent)]/5 via-transparent to-transparent opacity-0 transition-opacity duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:opacity-100 pointer-events-none"></div>

            <div 
              aria-hidden="true"
              class="relative z-10 mb-8 flex h-14 w-14 items-center justify-center rounded-2xl border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-text)] shadow-sm transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 group-hover:-translate-y-1 group-hover:border-[var(--color-accent)]/50 group-hover:bg-[var(--color-accent)]/10 group-hover:text-[var(--color-accent)] transform-gpu"
            >
              <Fragment set:html={premiumIcons[service.slug]} />
            </div>

            <h3 class="relative z-10 text-2xl font-bold tracking-tight text-[var(--color-text)] transition-colors duration-500 lg:text-3xl">
              {service.title}
            </h3>

            <p class="relative z-10 mt-4 text-lg leading-relaxed text-[var(--color-text-muted)]">
              {service.shortDescription}
            </p>

            <ul 
              class="relative z-10 mt-8 flex-1 space-y-3"
              aria-label={`Key features of ${service.title}`}
            >
              {
                service.cardHighlights.map((item) => (
                  <li class="flex items-start gap-3 text-[var(--color-text-muted)] transition-colors duration-300 group-hover:text-[var(--color-text)]">
                    <span aria-hidden="true" class="mt-2.5 flex h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]/60 transition-transform duration-500 group-hover:scale-150"></span>
                    <span class="font-medium text-base">{item}</span>
                  </li>
                ))
              }
            </ul>

            <div class="relative z-10 mt-10 flex items-center justify-between border-t border-[var(--color-border)] pt-6">
              
              <span class="text-sm font-bold uppercase tracking-widest text-[var(--color-text-muted)] transition-colors duration-500 group-hover:text-[var(--color-text)]">
                Learn More <span class="sr-only">about {service.title}</span>
              </span>

              <span 
                aria-hidden="true"
                class="flex h-12 w-12 items-center justify-center rounded-full border border-[var(--color-border)] bg-[var(--color-background)] text-[var(--color-text-muted)] transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-110 group-hover:border-[var(--color-accent)] group-hover:bg-[var(--color-accent)] group-hover:text-white dark:group-hover:text-black transform-gpu shadow-sm group-hover:shadow-md"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5 w-5 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1 transform-gpu">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </span>

            </div>

          </a>
        ))
      }

    </div>

  </Container>
</section>